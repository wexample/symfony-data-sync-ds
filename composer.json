{
  "name": "wexample/symfony-data-sync-ds",
  "description": "Design-system screens to review and apply symfony-data-sync plans",
  "type": "library",
  "license": "MIT",
  "version": "2.0.12",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyDataSyncDs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyDataSyncDs\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-api": ">=11.0.0",
    "wexample/symfony-data-sync": ">=3.0.0",
    "wexample/symfony-design-system": ">=30.0.0",
    "wexample/symfony-helpers": ">=15.0.0",
    "wexample/symfony-loader": ">=20.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}