{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    {%- set rows = [] -%}
    {%- for key, definition in definitions -%}
        {%- set href = path('data_sync_definition', { key: key }) -%}
        {%- set rows = rows | merge([{
            definition: { href: href, label: key },
            local: include('@WexampleSymfonyDataSyncDsBundle/pages/data_sync/_class_name.html.twig', { fqcn: definition.localClass }),
            remote: include('@WexampleSymfonyDataSyncDsBundle/pages/data_sync/_class_name.html.twig', { fqcn: definition.adapterClass }),
            open: [{ icon: 'ph:bold/arrow-right', href: href, label: '@page::open' | trans }],
        }]) -%}
    {%- endfor -%}

    {{ data_table([
        { key: 'definition', label: '@page::column.definition' | trans, cell: 'link', width: 'm' },
        { key: 'local', label: '@page::column.local' | trans, cell: 'html' },
        { key: 'remote', label: '@page::column.remote' | trans, cell: 'html' },
        { key: 'open', label: '', cell: 'actions', align: 'right' },
    ], rows, {
        hover: true,
        show_count: true,
        empty_label: '@page::empty' | trans,
    }) }}
{%- endblock -%}
