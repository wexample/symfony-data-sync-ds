{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_body -%}
    <section class="block block--card">
        <div class="block--body">
            {%- if definitions is empty -%}
                <p>{{ '@page::empty' | trans }}</p>
            {%- else -%}
                <table class="table">
                    <thead>
                    <tr class="table--row">
                        <th class="table--cell" scope="col">{{ '@page::column.definition' | trans }}</th>
                        <th class="table--cell" scope="col">{{ '@page::column.local' | trans }}</th>
                        <th class="table--cell" scope="col">{{ '@page::column.remote' | trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {%- for key, definition in definitions -%}
                        <tr class="table--row">
                            <td class="table--cell"><a href="{{ path('data_sync_definition', { key: key }) }}">{{ key }}</a></td>
                            <td class="table--cell"><code>{{ definition.localClass }}</code></td>
                            <td class="table--cell"><code>{{ definition.adapterClass }}</code></td>
                        </tr>
                    {%- endfor -%}
                    </tbody>
                </table>
            {%- endif -%}
        </div>
    </section>
{%- endblock -%}
